{
  "expo": {
    "name": "blindmatch",
    "slug": "blindmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.blindmatch.app"
    },
    "android": {
      "package": "se.blindmatch.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Appen behöver dina bilder för att visa din profil."
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "scheme": "blindmatch"
  }
}
